# ── LLM Provider (groq | openai | azure_openai) ─────────────────────
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (uncomment if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Azure OpenAI (uncomment if LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_LLM_DEPLOYMENT=your-deployment-name

# ── Embedding Provider (ollama | openai | azure_openai) ─────────────
EMBEDDING_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# OpenAI Embeddings (uncomment if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...          # same key as above if using OpenAI for LLM too
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Azure OpenAI Embeddings (uncomment if EMBEDDING_PROVIDER=azure_openai)
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment
# EMBEDDING_DIMENSION=1536

# ── Database ────────────────────────────────────────────────────────
# Supported: postgresql | mysql | mssql | snowflake | bigquery | databricks
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=northwind
DB_SCHEMA=public

# For cloud databases (Snowflake, BigQuery, Databricks), use a full connection string instead:
# DB_CONNECTION_STRING=snowflake://user:pass@account/db/schema?warehouse=WH&role=ROLE

# Legacy aliases (still work as fallback for PostgreSQL):
# PG_HOST, PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE

# ── FAISS ───────────────────────────────────────────────────────────
FAISS_PERSIST_DIR=./faiss_indices

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

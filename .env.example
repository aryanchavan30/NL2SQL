# ── LLM Provider (groq | openai | azure_openai | ollama) ─────────────
LLM_PROVIDER=groq

# LLM_MODE controls MDL enrichment concurrency during DB introspection:
#   local = concurrent (4 tables at a time) — use for Ollama/local models (fast)
#   api   = sequential (1 table at a time) — use for Groq/OpenAI/Azure (avoids rate limits)
LLM_MODE=api

# Groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (uncomment if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Azure OpenAI (uncomment if LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_LLM_DEPLOYMENT=your-deployment-name

# Ollama LLM (uncomment if LLM_PROVIDER=ollama)
# OLLAMA_LLM_MODEL=llama3.2

# ── Embedding Provider (ollama | openai | azure_openai) ─────────────
EMBEDDING_PROVIDER=ollama

# Ollama (embeddings — always needed if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# OpenAI Embeddings (uncomment if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...          # same key as above if using OpenAI for LLM too
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Azure OpenAI Embeddings (uncomment if EMBEDDING_PROVIDER=azure_openai)
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment
# EMBEDDING_DIMENSION=1536

# ── Database ────────────────────────────────────────────────────────
# Supported: postgresql | mysql | mssql | snowflake | bigquery | databricks
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=northwind
DB_SCHEMA=public

# For cloud databases (Snowflake, BigQuery, Databricks), use a full connection string instead:
# DB_CONNECTION_STRING=snowflake://user:pass@account/db/schema?warehouse=WH&role=ROLE

# Legacy aliases (still work as fallback for PostgreSQL):
# PG_HOST, PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE

# ── Vector Store (faiss | qdrant) ────────────────────────────────────
VECTOR_STORE_PROVIDER=faiss

# FAISS (used when VECTOR_STORE_PROVIDER=faiss)
FAISS_PERSIST_DIR=./faiss_indices

# Qdrant (used when VECTOR_STORE_PROVIDER=qdrant)
# Start with Docker: docker run -d -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                   # leave empty for local Docker

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Intent Override ──────────────────────────────────────────────────
# Set to SQL to force all queries through as TEXT_TO_SQL.
# LLM still runs for question rephrasing — only intent result is overridden.
# Leave empty for normal classification (TEXT_TO_SQL | MISLEADING_QUERY | GENERAL).
INTENT_OVERRIDE=

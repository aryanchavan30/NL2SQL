# Groq LLM
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Database — pick your db_type and fill in connection details
# Supported: postgresql | mysql | mssql | snowflake | bigquery | databricks
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=northwind
DB_SCHEMA=public

# For cloud databases (Snowflake, BigQuery, Databricks), use a full connection string instead:
# DB_CONNECTION_STRING=snowflake://user:pass@account/db/schema?warehouse=WH&role=ROLE

# Legacy aliases (still work as fallback for PostgreSQL):
# PG_HOST, PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE

# FAISS
FAISS_PERSIST_DIR=./faiss_indices

# Logging
LOG_LEVEL=INFO
